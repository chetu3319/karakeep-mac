# Karakeep Desktop App - Environment Configuration

# The base URL of your Karakeep instance
# Example: http://localhost:3000 (for local development)
# Example: https://bookmarks.example.com (for a remote instance)
KARAKEEP_BASE_URL=http://localhost:3000

# API key from your Karakeep instance
# Get this from: Settings → API keys in your Karakeep web app
# This is a Bearer token used to authenticate all API requests
KARAKEEP_API_KEY=your_api_key_here
